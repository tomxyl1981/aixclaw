__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.coverage

# Node
node_modules/
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp

# Databases
*.db
*.sqlite*

